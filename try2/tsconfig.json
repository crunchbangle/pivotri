{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "noEmit": true,
        "lib": ["ES2020", "DOM"],
        "types": ["node", "jest"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
